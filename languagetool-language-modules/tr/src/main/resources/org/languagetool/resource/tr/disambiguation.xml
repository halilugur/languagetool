<rules lang="tr" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../../../../../../../../languagetool-core/src/main/resources/org/languagetool/resource/disambiguation.xsd">

  <!--
  Turkish disambiguation rules. The tagger uses a coarse Universal Dependencies
  UPOS tagset; these rules resolve common ambiguities using local context.

  Note: coverage is intentionally limited to high-confidence patterns. Many
  Turkish ambiguities (e.g. gelir = VERB/NOUN) require richer features than the
  flat UPOS tags provide; those are left to future expansion with a finer tagset.
  -->

  <!-- Punctuation: a pure punctuation token keeps only the PUNCT reading.
       This removes spurious non-PUNCT readings the dictionary may attach. -->
  <rulegroup id="PUNCT" name="Noktalama işaretleri">
    <rule>
      <pattern>
        <marker>
          <token regexp="yes">[.\,\;\:\!\?\"\'\(\)\[\]\{\}\-—–…«»„“”‘’]</token>
        </marker>
      </pattern>
      <disambig action="filter" postag="PUNCT"/>
      <example type="untouched">Geldim .</example>
    </rule>
  </rulegroup>

</rules>
